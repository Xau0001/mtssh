# Maintainer: Xau0001 <https://github.com/Xau0001>
pkgname=mtssh
pkgver=1.0.0
pkgrel=1
pkgdesc="Multi-Tabbed SSH Client — Graphical SSH tool with SFTP, themes, AES-encrypted sessions"
arch=('x86_64' 'aarch64')
url="https://github.com/Xau0001/mtssh"
license=('MIT')
depends=('glibc' 'mesa' 'libx11' 'libxrandr' 'libxcursor' 'libxinerama' 'libxi' 'wayland' 'libxkbcommon')
makedepends=('go' 'gcc' 'git')
# Tags can be moved: when publishing this PKGBUILD for a release, pin the
# tag's commit instead (#commit=<full sha>) or verify a signed tag
# (#tag=v$pkgver?signed plus validpgpkeys).
source=("$pkgname::git+https://github.com/Xau0001/mtssh.git#tag=v$pkgver")
sha256sums=('SKIP')
# The public release key (the UPDATE_PUBLIC_KEY repository variable, see
# tools/signsums). Set it when publishing this PKGBUILD for a release:
# MTSSH then announces only releases signed with it. Left empty, MTSSH
# announces every newer release unchecked.
_update_pubkey=''

build() {
    # A malformed key would build fine and silently check nothing.
    if [[ -n "$_update_pubkey" && ! "$_update_pubkey" =~ ^[A-Za-z0-9+/]{43}=$ ]]; then
        echo "_update_pubkey is not a base64 Ed25519 public key" >&2
        return 1
    fi
    cd "$srcdir/$pkgname"
    export CGO_ENABLED=1
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
    # -linkmode=external must be in the same -ldflags: a second -ldflags
    # (e.g. in GOFLAGS) is overridden, not merged.
    go build -v \
        -ldflags "-linkmode=external -s -w -X main.Version=$pkgver -X mtssh/core.Packaged=true -X mtssh/core.UpdatePublicKey=$_update_pubkey" \
        -o mtssh .
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 mtssh "$pkgdir/usr/bin/mtssh"
    install -Dm644 install/mtssh.desktop "$pkgdir/usr/share/applications/mtssh.desktop"
    install -Dm644 icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/mtssh.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# ── Local install without AUR ─────────────────────────────────────────────────
# To install directly from the cloned repo (no GitHub release needed):
#
#   bash install/install-linux.sh
